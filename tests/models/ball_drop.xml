<mujoco model="ball_drop">
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>

  <default>
    <geom condim="4"/>
  </default>

  <asset>
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.8 0.8 0.8" rgb2="0.6 0.6 0.6" width="512" height="512"/>
    <material name="matplane" texture="texplane" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" material="matplane" friction="1.0 0.005 0.001"/>

    <body name="ball" pos="0 0 2.0">
      <freejoint/>
      <inertial mass="0.5" pos="0 0 0" diaginertia="0.001 0.001 0.001"/>
      <geom name="ball_geom" type="sphere" size="0.05" rgba="0.9 0.2 0.2 1" friction="0.8 0.005 0.001"/>
    </body>
  </worldbody>
</mujoco>
